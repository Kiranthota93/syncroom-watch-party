# ─────────────────────────────────────────────────────────────────────────────
# Backend environment
#
# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# The server reads these once at startup and fails fast if a required one is
# missing, so a misconfigured deploy crashes immediately instead of running
# in a half-broken state.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required — server will not boot without these ──

# Primary frontend origin. Also the first entry in the CORS allowlist.
CLIENT_URL=http://localhost:5173

# MongoDB connection string. SECRET — contains the database password.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/sync_db?retryWrites=true&w=majority

# ── Core ──

PORT=8000

# production | development
# In production, http://localhost:5173 is NOT auto-added to the CORS allowlist.
NODE_ENV=production

# debug | info | warn | error
LOG_LEVEL=info

# ── CORS / Socket.IO origins ──
#
# Comma-separated ADDITIONAL origins beyond CLIENT_URL. Every host the frontend
# is actually served from must appear here or in CLIENT_URL. An origin that is
# missing gets no Access-Control-Allow-Origin header and the browser blocks the
# socket handshake — which looks like "websockets are broken" even though the
# server upgraded the connection correctly.
#
# CLIENT_URLS=https://app.example.com,https://your-tunnel.ngrok-free.dev
CLIENT_URLS=

# ── WebRTC (voice / video calls) ──
#
# JSON array of RTCIceServer objects. STUN alone is enough for most home
# networks; without a TURN relay, calls fail for users behind symmetric NAT or
# corporate firewalls — intermittently, and only in the real world.
# TURN credentials come from your TURN provider or your own coturn server.
#
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"USER","credential":"PASS"}]
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# ── Room / participant limits ──

MAX_PARTICIPANTS=10
MAX_CAMERAS_ON=6

# How long a disconnected participant keeps their room state (online status,
# call membership, controller role). Long enough to survive a page reload.
DISCONNECT_GRACE_MS=15000

# ── Uploaded video storage ──
#
# MUST point at persistent storage. In Docker this has to be a mounted volume —
# the default container filesystem is wiped on every redeploy, which would
# destroy uploaded videos while the database still references them.
# Defaults to ./var/syncroom-uploads on Windows, /var/syncroom-uploads elsewhere.
UPLOADS_DIR=/var/syncroom-uploads

# 2 GB per file
UPLOAD_MAX_FILE_SIZE_BYTES=2147483648
# Refuse uploads that would leave less than 1 GB free
UPLOAD_MIN_FREE_DISK_BYTES=1073741824

# ── Room lifecycle / automatic cleanup ──
#
# active --(inactive)--> expired --(retention)--> deleted, with uploads removed.

# How often the sweep runs (10m)
ROOM_SWEEP_INTERVAL_MS=600000

# Empty / all-offline this long before expiring (6h). Keep this generous: an
# expired room disappears from "My Rooms" AND stops accepting joins, so a short
# value reads to the host as "it lost my room".
ROOM_EMPTY_GRACE_MS=21600000

# Hard ceiling — expire even an occupied room after this much inactivity (24h)
ROOM_MAX_IDLE_MS=86400000

# Keep expired/ended rooms this long before hard deletion (7d)
ROOM_RETENTION_MS=604800000

# true  = dry run; log what WOULD be deleted, delete nothing (safe default)
# false = actually delete expired rooms and reclaim their disk space
ROOM_CLEANUP_DRY_RUN=false

# ── Admin console (/admin) ──
#
# SECRET. Single shared passkey guarding room/content deletion. Leave unset to
# disable the admin API entirely (it fails closed — there is no default).
# Use a long random value:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSKEY=
