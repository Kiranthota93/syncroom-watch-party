PORT=8000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://syncroom_db_user:your_password@sync-room-cluster.cpmfomu.mongodb.net/sync_db?retryWrites=true&w=majority&appName=sync-room-cluster
NODE_ENV=development
LOG_LEVEL=debug

# ── Uploaded video storage ──
# Where streamed-video uploads are written, as {UPLOADS_DIR}/{invite_token}/{file_id}{ext}.
# Must be on a volume with room for full-size video files. This relative path
# works on Windows and Linux; production can use an absolute path instead.
UPLOADS_DIR=./var/syncroom-uploads
UPLOAD_MAX_FILE_SIZE_BYTES=2147483648
UPLOAD_MIN_FREE_DISK_BYTES=1073741824

# ── Room lifecycle / cleanup ──
# Rooms are expired (status -> "expired") when inactive, then hard-deleted with
# their uploads after the retention window.
ROOM_SWEEP_INTERVAL_MS=600000     # how often the sweep runs (10m)
ROOM_EMPTY_GRACE_MS=900000        # empty / all-offline this long -> expire (15m)
ROOM_MAX_IDLE_MS=86400000         # hard ceiling even if occupied (24h)
ROOM_RETENTION_MS=604800000       # keep expired rooms this long, then delete (7d)

# Deleting rooms and their video files is irreversible, so it is opt-in.
# Leave true to only log what would be removed; set false to actually delete.
ROOM_CLEANUP_DRY_RUN=true

# ── Admin console (/admin) ──
# Single shared passkey guarding the admin API. Leave unset to disable the
# admin surface entirely (it fails closed — there is no default value).
# Use a long random string; it is the only thing protecting room deletion.
ADMIN_PASSKEY=
