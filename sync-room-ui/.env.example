# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment
#
# IMPORTANT: Vite inlines VITE_* values into the bundle at BUILD time. Changing
# them requires a rebuild/redeploy — restarting the server does nothing. The
# dev server also only reads this file at startup, so restart it after edits.
# ─────────────────────────────────────────────────────────────────────────────

# ── API / socket target ──
# Leave BOTH EMPTY when the frontend and API are served from the same origin
# (the docker-compose setup, where nginx proxies /api and /socket.io). The app
# then uses the page's own origin, which works for localhost, a LAN IP and a
# tunnel without any change.
#
# Set them only when the frontend is hosted separately from the API — e.g. a
# Vercel frontend talking to a standalone API host:
#   VITE_API_URL=https://syncroom-api.example.com
#   VITE_SOCKET_URL=https://syncroom-api.example.com
#
# If you set these, the API's CLIENT_URL / CLIENT_URLS must include this
# frontend's origin or the browser blocks the socket handshake.
VITE_API_URL=
VITE_SOCKET_URL=

# debug | info | warn | error
VITE_LOG_LEVEL=warn

# ─────────────────────────────────────────────────────────────────────────────
# Dev-server only (not read by production builds)
# ─────────────────────────────────────────────────────────────────────────────

# Extra hostnames the Vite dev server will accept. Needed when exposing the
# dev server through a tunnel — without it Vite rejects the Host header.
# DEV_ALLOWED_HOSTS=your-tunnel.ngrok-free.dev

# Where the dev server proxies /api and /socket.io.
# DEV_API_TARGET=http://localhost:8000
